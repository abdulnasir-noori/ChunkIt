# Copy to .env. Never commit .env.
POSTGRES_USER=tracker
POSTGRES_PASSWORD=change_me
POSTGRES_DB=tracker
JWT_SECRET=change_me_to_a_long_random_string

# EMAIL_MODE=log prints emails to the console (demo fallback). Use "resend" to really send.
EMAIL_MODE=log
RESEND_API_KEY=
EMAIL_FROM=Assignment Tracker <onboarding@resend.dev>
NOTIFY_WINDOW_HOURS=48
NOTIFY_INTERVAL_MINUTES=15

# Only needed for Swarm deploys: your Docker Hub username
REGISTRY_USER=your_dockerhub_username
